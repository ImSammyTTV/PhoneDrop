{
  "name": "phonedrop",
  "version": "2.1.0",
  "description": "Send files and share your clipboard between your iPhone, iPad, Mac and PC, over Wi-Fi at home and Tailscale away",
  "author": "ImSammyTTV",
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never -c.win.signAndEditExecutable=true",
    "icons": "node scripts/make-icons.js && node gen-icon.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sam.phonedrop",
    "productName": "PhoneDrop",
    "files": [
      "main.js",
      "preload.cjs",
      "icon.png",
      "icons/*.png",
      "renderer/**/*",
      "server/**/*",
      "shared/**/*",
      "core/**/*",
      "web/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "PhoneDrop-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "PhoneDrop",
      "artifactName": "PhoneDrop-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ImSammyTTV",
        "repo": "PhoneDrop"
      }
    ]
  }
}
