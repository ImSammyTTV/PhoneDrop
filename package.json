{
  "name": "phonedrop",
  "version": "1.1.0",
  "description": "Receive files from your iPhone into a folder on this PC",
  "author": "ImSammyTTV",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sam.phonedrop",
    "productName": "PhoneDrop",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "PhoneDrop"
    }
  }
}
